# Python
__pycache__/
*.pyc
.venv/
venv/
*.egg-info/
.cache/

# Node / frontend
node_modules/
frontend/dist/
npm-debug.log*

# Local Android toolchain and generated build intermediates
.android-local/
android-app/.gradle/
android-app/build/
android-app/app/build/
android-app/local.properties

# Local dev logs
*.log

# TypeScript incremental build cache
*.tsbuildinfo

# Editors / OS
.vscode/
.idea/
.DS_Store
Thumbs.db

# Env
.env
.env.local
# A stray double-dot spelling that exists in this working tree and holds a real
# API key. `.env` does not match it, so without this line `git add -A` would
# commit the key.
..env

# Local libSQL fallback DB (used when Turso credentials aren't set)
backend/app/data/store/

# Naver blog export output and, critically, the logged-in browser profile under
# exports/naver_blog/browser_session/ — that directory holds live NID_AUT/NID_SES
# session cookies and Chromium's "Login Data" store. Committing it would publish the
# blog account's session to the repo. The exported HTML alongside it is regenerated
# from market_close_briefs on every run, so nothing here needs version control.
exports/

# Diagnostic dump from scripts/naver_probe_editor.py — a snapshot of SmartEditor
# internals, regenerated on demand and not source.
backend/scripts/_probe_documentmodel.json

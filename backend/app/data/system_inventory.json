  "schedules": [
    {
      "file": "ai-prediction.yml",
      "cron": [
        "0 14 * * 1-5",
        "0 13 * * 0",
        "0 3 * * 2-6",
        "0 4 * * 2-6",
        "0 2 * * 1",
        "0 3 * * 1"
      ],
      "endpoints": [
        "/api/health",
        "/api/prediction/run",
        "/api/prediction/run/status"
      ]
    },
    {
      "file": "dram-price-refresh.yml",
      "cron": [
        "0 11 * * *"
      ],
      "endpoints": [
        "/api/health",
        "/api/market/dram-price/refresh"
      ]
    },
    {
      "file": "global-top100-refresh.yml",
      "cron": [
        "30 19 * * *"
      ],
      "endpoints": [
        "/api/global-top100/refresh",
        "/api/health"
      ]
    },
    {
      "file": "kakao-notify.yml",
      "cron": [
        "5 * * * *"
      ],
      "endpoints": [
        "/api/health",
        "/api/notify/kakao/run"
      ]
    },
    {
      "file": "keep-alive.yml",
      "cron": [
        "*/30 * * * *"
      ],
      "endpoints": [
        "/api/health",
        "/api/investor/indices",
        "/api/market/kosdaq-map",
        "/api/market/map",
        "/api/stock/005930/"
      ]
    }
  ],
